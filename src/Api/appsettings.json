{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "Default": "ConnectionString",
    "UserAccessDb": "UserAccessConnectionString",
    "RentalsDb": "RentalsConnectionString",
    "PaymentsDb": "PaymentsConnectionString",
    "ListingsDb": "ListingsConnectionString"
  },
  
  "Listings": {
    "S3": {
      "BucketName": "heavyrent-listings-images-792705600599-us-east-2-an",
      "BasePrefix": "listings"
    }
  },
  
  "AWS": {
    "Region": "us-east-2"
  }
  
  ,
  "Security": {
    "CpfProtectionKey": "ProtectionKey",
    "CodeProtectionKey": "ProtectionKey"
  },
  "AllowedHosts": "*",


  
  

  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "Enrich": [ "FromLogContext" ],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] [{RequestId}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },

  "Jwt": {
    "Issuer": "HeavyRentApi",
    "Audience": "HeavyRentClient",
    "SigningKey": "SecretKey",
    "AccessTokenMinutes": 15
  },
  
  "Refresh": {
   "RefreshTokenDays" : 7
  },
  
  "Email": {
    "ApiKey" : "ApiKey",
    "From" : "From"
  },
  
  "ApiCpf": {
    "BaseUrl": "https://apicpf.com",
    "ApiKey": "ApiKey"
  },

  "Didit": {
    "BaseUrl": "https://verification.didit.me",
    "ApiKey": "ApiKey",
    "WebhookSecret": "WebhookSecret",
    "WorkflowId": "WorkflowId"
  }

}
